#!/usr/bin/env bash
# Public-safety gate before anything reaches GitHub. Vets every commit being pushed:
# each commit's full tree (a file added and later deleted is still in history),
# author/committer identity, commit messages and annotated tag messages. git passes
# "<remote name> <url>" as arguments and one "<local ref> <local sha> <remote ref>
# <remote sha>" line per ref on stdin.
set -u

remote="${1:-origin}"
hook_dir="$(dirname "$(realpath "$0")")"
top="$(git rev-parse --show-toplevel)" || exit 1
checker="$hook_dir/../tools/check_public.py"
[ -f "$checker" ] || checker="$top/tools/check_public.py"
if [ ! -f "$checker" ]; then
    echo "pre-push: tools/check_public.py not found next to $hook_dir or in $top; refusing to push without the public-safety check." >&2
    exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # all zeros: ref deletion
    case "$remote_sha" in
        *[!0]*)
            if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
                revs="${remote_sha}..${local_sha}"
            else
                revs="${local_sha} --not --remotes=${remote}"
            fi ;;
        *)  revs="${local_sha} --not --remotes=${remote}" ;;   # new ref on the remote
    esac
    echo "pre-push: vetting ${local_ref} -> ${remote_ref} (${revs})" >&2
    if ! python3 -I "$checker" --commits="$revs"; then
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: public-safety check failed; push blocked. Nothing was sent." >&2
fi
exit "$status"
