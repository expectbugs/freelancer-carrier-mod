// Policy round trip (test profile). A snapshot reports 7 nanobots; a push-to-talk down/up makes
// the sidecar's fake pipeline send a canned policy.set reserving them for a capital ship, then
// a say line. The fake client acks both; its policy.set ack is computed like the DLL's (clamped,
// full resulting policy in "applied").
{"expect": {"t": "welcome", "profile": "test"}}
{"send": {"t": "state", "rate": "calm", "ship": {"hull": 0.9, "shield": 1.0, "shield_up": true, "bots": 7, "batts": 3, "mode": "free", "system": "test_system"}, "target": null, "threat": {"hostiles": 0, "capital_hostile": false}, "ui": {"paused": false, "focused": true}}}
{"ptt": "down"}
{"sleep": 0.05}
{"ptt": "up"}
{"expect": {"t": "policy.set", "id": {"$re": "c-[0-9]+"}, "scope": "player", "bots_reserve": 7, "release_reserve_when": "capital_hostile_present", "auto_bots": "$absent"}, "timeout": 3}
{"ack": {"ok": true}}
{"expect": {"t": "say", "id": {"$re": "c-[0-9]+"}, "speaker": "copilot", "text": {"$contains": "nanobots"}, "subtitle": true}}
{"ack": {"ok": true, "applied": {"shown": true}}}
{"expect_silence": 0.3}
{"disconnect": true}
